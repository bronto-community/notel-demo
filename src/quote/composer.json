{
    "name": "openteletry-demo/quote",
    "description": "Quote Service part of OpenTelemetry Demo",
    "license": "Apache-2.0",
    "require": {
        "php": ">= 8.5",
        "ext-json": "*",
        "ext-pcntl": "*",
        "monolog/monolog": "3.12.0",
        "php-di/php-di": "7.1.1",
        "php-di/slim-bridge": "3.4.1",
        "react/http": "v1.11.1",
        "slim/psr7": "1.8.0",
        "slim/slim": "4.15.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
